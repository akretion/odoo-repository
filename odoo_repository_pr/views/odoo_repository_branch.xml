<odoo>

  <record id="odoo_repository_branch_view_form" model="ir.ui.view">
    <field name="model">odoo.repository.branch</field>
    <field name="inherit_id" ref="odoo_repository.odoo_repository_branch_view_form" />
    <field name="arch" type="xml">
        <group name="modules" position="after">
            <group name="forks" string="Forks">
                <field name="forked_branch_ids" nolabel="1" colspan="2">
                  <tree>
                    <field name="name" />
                    <field name="module_branch_ids" widget="many2many_tags" />
                  </tree>
                </field>
            </group>
        </group>
    </field>
  </record>

</odoo>
