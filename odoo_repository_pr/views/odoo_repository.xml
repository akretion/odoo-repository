<odoo>

  <record id="odoo_repository_view_form" model="ir.ui.view">
    <field name="name">odoo.repository.form</field>
    <field name="model">odoo.repository</field>
    <field name="inherit_id" ref="odoo_repository.odoo_repository_view_form" />
    <field name="arch" type="xml">
        <field name="name" position="after">
          <field name="source_repository_id" />
        </field>

        <field name="name" position="after">
          <field name="forked_branch_ids" />
        </field>
    </field>
  </record>


</odoo>
