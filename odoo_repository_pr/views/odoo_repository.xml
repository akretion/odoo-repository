<odoo>

  <record id="odoo_repository_view_form" model="ir.ui.view">
    <field name="name">odoo.repository.form</field>
    <field name="model">odoo.repository</field>
    <field name="inherit_id" ref="odoo_repository.odoo_repository_view_form" />
    <field name="arch" type="xml">
      <header position="inside">
          <button
                    name="action_fetch_prs"
                    type="object"
                    string="Fetch PRs"
                    class="btn-secondary"
                    groups="base.group_system"
                />
          <button
                    name="action_fetch_prs_full"
                    type="object"
                    string="Fetch PRs (full)"
                    class="btn-secondary"
                    groups="base.group_no_one"
                />
      </header>
      <field name="name" position="after">
        <field name="source_repository_id" />
        <field name="last_pr_fetched" groups="base.group_no_one" />
      </field>
      <group name="branches" position="after">
        <field name="is_fork" invisible="1" />
        <group name="forks" string="Forks">
          <field name="forked_repository_ids" nolabel="1" colspan="2" />
        </group>
        <group
                    name="forked_repository_forked_branchess"
                    string="Forked Branches (All)"
                    attrs="{'invisible': [('is_fork', '=', True)]}"
                >
          <field name="forked_repository_forked_branch_ids" nolabel="1" colspan="2" />
        </group>
        <group
                    name="forked_branches"
                    string="Forked Branches"
                    attrs="{'invisible': [('is_fork', '=', False)]}"
                >
          <field name="forked_branch_ids" nolabel="1" colspan="2" />
        </group>
      </group>
    </field>
  </record>

  <record id="action_odoo_repository_fetch_prs" model="ir.actions.server">
      <field name="name">Fetch PRs</field>
      <field name="model_id" ref="odoo_repository.model_odoo_repository" />
      <field name="binding_model_id" ref="odoo_repository.model_odoo_repository" />
      <field name="binding_view_types">list</field>
      <field name="groups_id" eval="[(4, ref('base.group_system'))]" />
      <field name="state">code</field>
      <field name="code">
          action = records.action_fetch_prs()
      </field>
  </record>

</odoo>
