<odoo>

    <record id="odoo_project_import_modules_view_form" model="ir.ui.view">
        <field name="model">odoo.project.import.modules</field>
        <field
            name="inherit_id"
            ref="odoo_project.odoo_project_import_modules_view_form"
        />
        <field name="arch" type="xml">
            <page name="init_modules_list" position="after">
                <page name="spec_yaml" string="Initialize from spec.yaml">
                    <div class="alert alert-warning" role="alert">
                      Initialize the list of modules that are installed in your project.
                      This will wipe the current installed modules.
                      <br />
                      The list can be copied-pasted from your project spec.yaml
                    </div>

                    <field
                        name="spec_yaml"
                        placeholder="queue:&#10;  modules:&#10;    - queue_job&#10;  src: https://github.com/oca/queue 16.0&#10;"
                    />
                </page>
            </page>
        </field>
    </record>

</odoo>
